# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_COMPANIES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REPORT_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ステータス変更ログDB（任意。週次レポートの Before/After 表示に使う）
NOTION_STATUS_CHANGE_LOG_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail (Google Cloud Console で取得)
GMAIL_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxx

# 同期対象期間（何日前までのメールを見るか）
SYNC_LOOKBACK_DAYS=2
